<!-- Custom Wazuh detection rules for the soc-lab.
     Target: Wazuh manager 4.9.x. Drop in as:
       /var/ossec/etc/rules/local_rules.xml   (then `systemctl restart wazuh-manager`)
     Chaining follows the stock 4.9 ruleset: Windows agents ship the Sysmon
     channel via eventchannel JSON, which the manager tags with the
     sysmon_eventN groups (see ruleset/rules/0595-win-sysmon_rules.xml in
     wazuh/wazuh @ v4.9.2), and decoded fields land under win.eventdata.*.
     Rule IDs are inside the 100000-120000 user range. -->

<group name="windows,sysmon,soclab,">

  <!-- Sysmon E13 (RegistryEvent ValueSet): run-key writing to a shady path -->
  <rule id="100201" level="8">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.eventType" type="pcre2">(?i)^SetValue$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)^(HKLM|HKCU|HKU)\\[^\\]+\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run(\\[^\\]+)?$</field>
    <field name="win.eventdata.details" type="pcre2">(?i)AppData\\Local\\Temp|ProgramData</field>
    <description>Persistence: run-key set to non-standard path</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!-- Sysmon E22 (DNS Query): first contact with a high-risk TLD -->
  <rule id="100202" level="5">
    <if_group>sysmon_event_22</if_group>
    <field name="win.eventdata.queryName" type="pcre2">(?i)\.(xyz|top|site|info)$</field>
    <description>New DNS query to a high-risk TLD</description>
    <mitre>
      <id>T1071.001</id>
    </mitre>
    <group>command_and_control,</group>
  </rule>

  <!-- Sysmon E1 (ProcessCreate): Office app spawning a shell (macro chain) -->
  <rule id="100203" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)(winword|excel|powerpnt)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(powershell|pwsh|mshta|cmd)\.exe$</field>
    <description>Office application spawned a shell (macro chain)</description>
    <mitre>
      <id>T1566.001</id>
    </mitre>
    <group>initial_access,</group>
  </rule>

</group>